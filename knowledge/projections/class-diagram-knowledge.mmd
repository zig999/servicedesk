classDiagram
    namespace CaseAggregate {
        class Case {
            <<AggregateRoot>>
            +string slug
            +string title
            +string whenToUse
            +integer version
            +string hash
            +SubjectType subject
            +Resolution fallback
            +ConsolidationRegister consolidationRegister
            +collectionPlan()
            +requiresEvaluationOf()
            +resolveOutcome()
        }
        class Hypothesis {
            <<Entity>>
            +string name
            +string criterion
            +Concept[] collects
            +Resolution resolution
        }
    }
    class ConsolidationRegister {
        <<Enumeration>>
        FORMAL
        PLAIN
    }
    class Referral {
        <<ValueObject>>
        +Action action
        +Recipient recipient
    }
    class Resolution {
        <<ValueObject>>
        +Outcome outcome
        +Referral referral
    }
    Case "1" *-- "1..*" Hypothesis
