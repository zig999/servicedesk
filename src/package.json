{
  "name": "servicedeskn1",
  "version": "0.1.0",
  "description": "ServiceDeskN1 — resolvedor de casos: recebe um caso curado e um sujeito, coleta as evidências que o caso pede, julga cada hipótese e devolve o desfecho com o encaminhamento.",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "secret-scan": "secretlint \"**/*\"",
    "test": "node --env-file=.env.test node_modules/.bin/vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "node --env-file=.env dist/migrate.js",
    "seed": "node --env-file=.env dist/seed.js",
    "start": "node --env-file=.env dist/index.js",
    "dev": "npm run build && npm run start"
  },
  "secretlint": {
    "rules": []
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "secretlint": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
