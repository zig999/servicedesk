{
  "name": "case-authoring-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "build": "vite build",
    "test:a11y": "playwright test --pass-with-no-tests",
