  "nodes": [
    {
      "id": "implementation/evidence-collection/evidence-collection-stage",
      "kind": "implementation",
      "file": "implementation/evidence-collection/evidence-collection-stage.md",
      "title": "The evidence-collection stage — parallel, budgeted, scoped observation over a case's plan",
      "summary": "Adds Evidence and collectEvidence, the orchestration that turns a pinned case's collection plan into exactly one Evidence per concept, calling observe-concept in parallel in the requester's own scope, each call bounded by the smaller of the capability's own timeout and the collection stage's seven-second ceiling within the propagated deadline.",
      "task": "task/evidence-collection/evidence-collection-stage"
    },
    {
      "id": "implementation/evidence-collection/observation-source-port",
      "kind": "implementation",
      "file": "implementation/evidence-collection/observation-source-port.md",
      "title": "Observation-source port and its fake adapter",
      "summary": "IObservationSource, the port the collection stage will call to observe one concept for one subject, and FakeObservationSource, the only concrete implementation this task ships — a fixture-driven double answering all four evidence-result endings with no real connector.",
      "task": "task/evidence-collection/observation-source-port"
    },
    {
      "id": "implementation/hypothesis-judgment/hypothesis-evaluator-port",
      "kind": "implementation",
      "file": "implementation/hypothesis-judgment/hypothesis-evaluator-port.md",
      "title": "Hypothesis-evaluator port and its fake adapter",
      "summary": "The IHypothesisEvaluator port and a fixture-driven FakeHypothesisEvaluator that judges one hypothesis's criterion against its own evidence, plus the verdict, evaluation-reason and citation vocabulary the port's answer is built from.",
      "task": "task/hypothesis-judgment/hypothesis-evaluator-port"
    },
    {
      "id": "implementation/investigation-lifecycle/idempotency-window",
      "kind": "implementation",
      "file": "implementation/investigation-lifecycle/idempotency-window.md",
      "title": "The idempotency-window lease mechanism",
      "summary": "A subject-type/subject-id/case/ticket-reference key, an in-memory key-and-instant lease store bound to a configured window, and a pure composition that tells a caller which of completed, in-progress or free applies — with no built Investigation and no wiring into a real diagnose entry point.",
      "task": "task/investigation-lifecycle/idempotency-window"
    },
    {
      "id": "proof/evidence-collection/evidence-collection-stage",
      "kind": "proof",
      "file": "proof/evidence-collection/evidence-collection-stage.md",
      "title": "Proof for the evidence-collection stage — parallel, budgeted, scoped observation over a case's plan",
      "summary": "Tests collectEvidence's five stated criteria plus the boundary, parallelism and rejection-propagation edge cases against a fake capability query, a scripted observation source and a delayed capability query, all under vitest fake timers so the stage's own internal setTimeout race is controlled deterministically.",
      "task": "task/evidence-collection/evidence-collection-stage"
    },
    {
      "id": "proof/evidence-collection/observation-source-port",
      "kind": "proof",
      "file": "proof/evidence-collection/observation-source-port.md",
      "title": "Proof for the observation-source port and its fake adapter",
      "summary": "Drives FakeObservationSource, the only concrete IObservationSource this task ships, through each of the four evidence-result endings and its one throwing fault, and audits src/investigation's own modules for import purity and for shipping exactly one adapter.",
      "task": "task/evidence-collection/observation-source-port"
    },
    {
      "id": "proof/hypothesis-judgment/hypothesis-evaluator-port",
      "kind": "proof",
      "file": "proof/hypothesis-judgment/hypothesis-evaluator-port.md",
      "title": "Proof for the hypothesis-evaluator port and its fake adapter",
      "summary": "Drives FakeHypothesisEvaluator, the only concrete IHypothesisEvaluator this task ships, through each of the three verdicts and its one throwing fault, exercises the task's own UNDERDETERMINED no-data/empty-citations fixture, and audits this task's own five modules for import purity and for shipping exactly one adapter.",
      "task": "task/hypothesis-judgment/hypothesis-evaluator-port"
    },
    {
      "id": "proof/investigation-lifecycle/idempotency-window",
      "kind": "proof",
      "file": "proof/investigation-lifecycle/idempotency-window.md",
      "title": "Idempotency window proof — key, lease store, and resolution",
      "summary": "Tests idempotencyKeyOf's deterministic and collision-free join, IdempotencyLeaseStore's key-and-instant-only lease and its window-bounded blocking, and resolveIdempotency's three-outcome precedence, including both of the task's UNDERDETERMINED entries as the implementation record resolved them.",
      "task": "task/investigation-lifecycle/idempotency-window"
    }
  ],
