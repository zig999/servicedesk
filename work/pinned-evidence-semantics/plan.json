{
  "contract_version": "siegard-plan/3",
  "nodes": [
    {
      "id": "epic/concept-description",
      "kind": "epic",
      "file": "epic/concept-description.md",
      "title": "Concept vocabulary carries a description",
      "summary": "The glossary's concept vocabulary gains a required description — refused missing at registration, tolerated absent on a legacy row, and returned wherever a concept is read."
    },
    {
      "id": "epic/concept-literal-fixture-maintenance",
      "kind": "epic",
      "file": "epic/concept-literal-fixture-maintenance.md",
      "title": "Concept literal fixture maintenance",
      "summary": "Pre-existing fixture and test-double literals across the backend tree are brought into compliance with the now-required Concept.description field, with no change to any existing assertion or behavior beyond that field."
    },
    {
      "id": "epic/evidence-semantics-snapshot",
      "kind": "epic",
      "file": "epic/evidence-semantics-snapshot.md",
      "title": "Evidence snapshots concept and field semantics at collection",
      "summary": "Evidence records its own snapshot of the producing capability's field semantics and the collected concept's own description, exactly as they stood at the moment of collection, durable across the relational investigation store."
    },
    {
      "id": "epic/judgment-reads-the-snapshot",
      "kind": "epic",
      "file": "epic/judgment-reads-the-snapshot.md",
      "title": "Judgment reads only the evidence snapshot",
      "summary": "A hypothesis's judgment, and the citation check over its answer, become a pure function of the evidence's own snapshotted semantics — never a live read of the glossary or the capability registry."
    },
    {
      "id": "epic/migration-runner-comment-hang-corrective",
      "kind": "epic",
      "file": "epic/migration-runner-comment-hang-corrective.md",
      "title": "migration-runner comment-hang corrective",
      "summary": "The one corrective task that stops applyMigrationFile from depending on the connection tolerating a query beginning with SQL comments."
    },
    {
      "id": "inventory/pinned-evidence-semantics",
      "kind": "inventory",
      "file": "inventory/pinned-evidence-semantics.md",
      "title": "Pinned evidence semantics across glossary, capability registry and investigation",
      "summary": "One backend territory spanning glossary concepts, capability output-schema reading and the evidence-collection/judgment pipeline, where semantics must move from live reads to a collection-time snapshot."
    },
    {
      "id": "inventory/pre-existing-concept-literals-scope",
      "kind": "inventory",
      "file": "inventory/pre-existing-concept-literals-scope.md",
      "title": "Pre-existing Concept-shaped literals outside the widening tasks",
      "summary": "Every Concept-typed object-literal site in the backend tree that TypeScript now refuses because description is required, beyond the three files the scope already named, plus four files whose runtime assertions will now mismatch."
    },
    {
      "id": "task/concept-description/concept-persistence-carries-description",
      "kind": "task",
      "file": "task/concept-description/concept-persistence-carries-description.md",
      "title": "Concept persistence carries a description, tolerant of a legacy row",
      "summary": "The relational glossary store persists a concept's description and reads a row written before this column existed without failing.",
      "epic": "concept-description"
    },
    {
      "id": "task/concept-description/concept-registration-requires-a-description",
      "kind": "task",
      "file": "task/concept-description/concept-registration-requires-a-description.md",
      "title": "Concept registration refuses a submission naming no description",
      "summary": "register-concept refuses a registration with no description, with a typed 422 error, and accepts one that states it.",
      "epic": "concept-description"
    },
    {
      "id": "task/concept-description/read-concept-returns-description",
      "kind": "task",
      "file": "task/concept-description/read-concept-returns-description.md",
      "title": "read-concept returns a concept's description",
      "summary": "GET /v1/glossary/concepts/{name} answers a held concept's description alongside its existing attributes, empty for a legacy concept.",
      "epic": "concept-description"
    },
    {
      "id": "task/concept-literal-fixture-maintenance/concept-assertion-description-repair",
      "kind": "task",
      "file": "task/concept-literal-fixture-maintenance/concept-assertion-description-repair.md",
      "title": "Runtime .toEqual assertions reconciled with the required description",
      "summary": "Pre-existing .toEqual assertions comparing GlossaryService's read-back Concept objects gain the description key their expected literals were missing, so each keeps passing once GlossaryService answers description: '' for a registration naming none.",
      "epic": "concept-literal-fixture-maintenance"
    },
    {
      "id": "task/concept-literal-fixture-maintenance/concept-literal-typecheck-repair",
      "kind": "task",
      "file": "task/concept-literal-fixture-maintenance/concept-literal-typecheck-repair.md",
      "title": "Typecheck-breaking Concept literals gain a description",
      "summary": "Every pre-existing Concept-shaped object literal that fails npm run typecheck against the widened Concept type receives a placeholder description value, with no other change.",
      "epic": "concept-literal-fixture-maintenance"
    },
    {
      "id": "task/evidence-semantics-snapshot/evidence-collection-snapshots-concept-and-field-semantics",
      "kind": "task",
      "file": "task/evidence-semantics-snapshot/evidence-collection-snapshots-concept-and-field-semantics.md",
      "title": "Evidence collection snapshots concept and field semantics",
      "summary": "Collecting a concept records, on its evidence, the producing capability's own declared field semantics and the concept's own declared description, exactly as they stood at that moment.",
      "epic": "evidence-semantics-snapshot"
    },
    {
      "id": "task/evidence-semantics-snapshot/investigation-store-persists-the-snapshot",
      "kind": "task",
      "file": "task/evidence-semantics-snapshot/investigation-store-persists-the-snapshot.md",
      "title": "The investigation store persists an evidence item's snapshotted semantics",
      "summary": "The relational investigation store persists and reads back an evidence item's fields and concept_description, additively over what it already stores.",
      "epic": "evidence-semantics-snapshot"
    },
    {
      "id": "task/judgment-reads-the-snapshot/evaluator-port-and-prompt-carry-snapshotted-semantics",
      "kind": "task",
      "file": "task/judgment-reads-the-snapshot/evaluator-port-and-prompt-carry-snapshotted-semantics.md",
      "title": "The evaluator port and its prompt carry the snapshotted semantics",
      "summary": "EvidenceItem widens to carry each item's own snapshotted field semantics and concept description, and the production prompt renders them inside the closed data block.",
      "epic": "judgment-reads-the-snapshot"
    },
    {
      "id": "task/judgment-reads-the-snapshot/judgment-stops-re-reading-the-registry",
      "kind": "task",
      "file": "task/judgment-reads-the-snapshot/judgment-stops-re-reading-the-registry.md",
      "title": "Judgment stops re-reading the capability registry",
      "summary": "Citation validation checks a field against its own cited evidence item's snapshot, and judgment-stage no longer resolves capabilities to judge a hypothesis.",
      "epic": "judgment-reads-the-snapshot"
    },
    {
      "id": "task/migration-runner-comment-hang-corrective/strip-leading-comments-before-applying",
      "kind": "task",
      "file": "task/migration-runner-comment-hang-corrective/strip-leading-comments-before-applying.md",
      "title": "applyMigrationFile strips leading comments before sending a migration's SQL to the connection",
      "summary": "A migration file's own -- comment lines and blank lines are removed before its text reaches the connection, so applying it never depends on the endpoint tolerating a comment-prefixed query; the same SQL statement(s) still run, in the same order.",
      "epic": "migration-runner-comment-hang-corrective"
    }
  ],
