  "nodes": [
    {
      "id": "epic/draft-correction-while-invalid",
      "kind": "epic",
      "file": "epic/draft-correction-while-invalid.md",
      "title": "Correcting a draft that does not read back as a case",
      "summary": "The backend reads a draft version's own declared attributes and accepts an update-draft over them, whichever validator rule fails over that draft."
    },
    {
      "id": "epic/draft-discard-while-invalid",
      "kind": "epic",
      "file": "epic/draft-discard-while-invalid.md",
      "title": "Discarding a draft that does not read back as a case",
      "summary": "The backend accepts a discard of a draft version whichever validator rule fails over it, with draft state as the only condition."
    },
    {
      "id": "inventory/case-version-read-and-edit-and-discard-path",
      "kind": "inventory",
      "file": "inventory/case-version-read-and-edit-and-discard-path.md",
      "title": "Backend read/validate/edit/discard path for an invalid case-version draft",
      "summary": "Surveys the case module and its HTTP layer where readCase throws instead of returning a violation list, blocking the editing surface the scope requires while discard already bypasses it."
    },
    {
      "id": "task/draft-correction-while-invalid/answer-update-draft-from-the-drafts-own-record",
      "kind": "task",
      "file": "task/draft-correction-while-invalid/answer-update-draft-from-the-drafts-own-record.md",
      "title": "Answer update-draft from the draft's own record",
      "summary": "update-draft builds its answer from the draft's own stored record after the write, not from read-case, so an update that leaves the draft failing validation is accepted.",
      "epic": "draft-correction-while-invalid"
    },
    {
      "id": "task/draft-correction-while-invalid/read-a-drafts-own-declared-attributes",
      "kind": "task",
      "file": "task/draft-correction-while-invalid/read-a-drafts-own-declared-attributes.md",
      "title": "Read a draft's own declared attributes from its stored record",
      "summary": "An operation answering a draft case version's title, when_to_use, subject, fallback and consolidation_register as its own stored record carries them, with no validator rule gating the answer.",
      "epic": "draft-correction-while-invalid"
    },
    {
      "id": "task/draft-correction-while-invalid/serve-a-drafts-own-declared-attributes-over-http",
      "kind": "task",
      "file": "task/draft-correction-while-invalid/serve-a-drafts-own-declared-attributes-over-http.md",
      "title": "Serve a draft's own declared attributes over HTTP",
      "summary": "An HTTP route, separate from read-case, that answers the draft's own-record read.",
      "epic": "draft-correction-while-invalid"
    },
    {
      "id": "task/draft-discard-while-invalid/prove-discard-accepts-a-draft-failing-validation",
      "kind": "task",
      "file": "task/draft-discard-while-invalid/prove-discard-accepts-a-draft-failing-validation.md",
      "title": "Prove discard accepts a draft failing validation",
      "summary": "Tests showing a discard of a draft is accepted while its manifest holds no entry or its declared subject fails glossary coherence.",
      "epic": "draft-discard-while-invalid"
    }
  ],
