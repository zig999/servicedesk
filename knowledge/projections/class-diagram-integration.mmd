classDiagram
    namespace CapabilityAggregate {
        class Capability {
            <<AggregateRoot>>
            +string name
            +string version
            +CapabilityNature nature
            +string inputSchema
            +string outputSchema
            +integer timeout
            +string connector
            +Concept concept
            +string payloadNotes
        }
    }
    class CapabilityNature {
        <<Enumeration>>
        READ_ONLY
        MUTATING
    }
    class CapabilityRegistry {
        <<Service>>
        +registerCapability()
        +removeCapability()
        +resolveConcept()
    }
    class CapabilitySchemaDraft {
        <<ValueObject>>
        +string inputSchema
        +string outputSchema
        +CapabilitySchemaDraftUnresolvedItem[] unresolved
    }
    class CapabilitySchemaDraftUnresolvedItem {
        <<ValueObject>>
        +string name
        +CapabilitySchemaDraftUnresolvedReason reason
    }
    class CapabilitySchemaDraftUnresolvedReason {
        <<Enumeration>>
        SCHEMA_NOT_REDUCIBLE_TO_A_TYPE
        NAME_CLAIMED_BY_ANOTHER_PARAMETER
    }
    class ConnectorConfiguration {
        <<ValueObject>>
        +string connector
        +string configuration
    }
    class ConnectorConfigurationDraft {
        <<ValueObject>>
        +string connector
        +string configuration
        +ConnectorConfigurationDraftUnresolvedItem[] unresolved
        +ConnectorConfigurationDraftGeneratedCredential[] generatedCredentials
        +ConnectorConfigurationDraftMethodMismatch methodMismatch
        +ConnectorConfigurationDraftStatusReading[] statusReadings
        +ConnectorConfigurationDraftResponseField[] responseFields
        +ConnectorConfigurationDraftReadingNote[] readingNotes
    }
    class ConnectorConfigurationDraftGeneratedCredential {
        <<ValueObject>>
        +string name
        +string securityScheme
    }
    class ConnectorConfigurationDraftMethodMismatch {
        <<ValueObject>>
        +string registered
        +string operation
    }
    class ConnectorConfigurationDraftReadingNote {
        <<ValueObject>>
        +ConnectorConfigurationDraftReadingNoteKind kind
        +string subject
        +string detail
    }
    class ConnectorConfigurationDraftReadingNoteKind {
        <<Enumeration>>
        DEFAULT_RESPONSE_NOT_DRAFTED
        STATUS_RANGE_NOT_DRAFTED
        NON_JSON_SUCCESS_CONTENT_NOT_READ
        ENVELOPE_READ_THROUGH
        VARIANTS_UNITED
        REPEATED_FIELD_NAME_PATH_NOT_TAKEN
        NO_RESPONSES_DECLARED
        NO_SUCCESS_RESPONSE_SCHEMA
        SUCCESS_SCHEMA_DECLARES_NO_PROPERTIES
    }
    class ConnectorConfigurationDraftResponseField {
        <<ValueObject>>
        +string name
        +string path
        +string status
        +string declaredType
        +boolean declaredRequired
        +string envelope
    }
    class ConnectorConfigurationDraftStatusReading {
        <<ValueObject>>
        +string status
        +EvidenceResult ending
        +string declaredAs
    }
    class ConnectorConfigurationDraftUnresolvedItem {
        <<ValueObject>>
        +string name
        +ConnectorConfigurationDraftUnresolvedReason reason
    }
    class ConnectorConfigurationDraftUnresolvedReason {
        <<Enumeration>>
        NO_CAPABILITY_REGISTERED
        SECURITY_SCHEME_NOT_REDUCIBLE_TO_A_CREDENTIAL
        DRAFTED_KEY_OCCUPIED_BY_ANOTHER_SECURITY_SCHEME
    }
    class ConnectorConfigurationRegistry {
        <<Service>>
        +registerConnector()
        +removeConnector()
    }
    class OpenapiDocumentOperations {
        <<ValueObject>>
        +OpenapiOperation[] operations
    }
    class OpenapiOperation {
        <<ValueObject>>
        +string path
        +string method
    }
    class Concept {
        <<external: glossary>>
    }
    class EvidenceResult {
        <<external: investigation>>
    }
    ConnectorConfigurationDraft "0..*" --> "0..*" Capability
