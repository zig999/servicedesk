      "id": "implementation/capability-timeout-contract-refusal/non-integer-timeout-refusal",
      "kind": "implementation",
      "file": "implementation/capability-timeout-contract-refusal/non-integer-timeout-refusal.md",
      "title": "Non-integer capability timeout is refused by the route's declared shape, not the service's contract-completeness check",
      "summary": "Removes the service-level misclassification of a declared-but-malformed capability timeout as an undeclared-attribute (422) refusal, leaving the route's own Zod shape validation (400 VALIDATION_ERROR) as the one mechanism that refuses it.",
      "task": "task/capability-timeout-contract-refusal/non-integer-timeout-refusal"
    },
    {
      "id": "implementation/connector-configuration-registration-conformance/configuration-held-as-text",
      "kind": "implementation",
      "file": "implementation/connector-configuration-registration-conformance/configuration-held-as-text.md",
      "title": "Connector-configuration registry holds configuration as text",
      "summary": "ConnectorConfiguration.configuration is now typed and held as JSON object text throughout registration, storage, single read and listing, with every consumer that derives an HTTP call parsing it back through one shared seam, for task/connector-configuration-registration-conformance/configuration-held-as-text.",
      "task": "task/connector-configuration-registration-conformance/configuration-held-as-text"
    },
    {
      "id": "implementation/connector-configuration-registration-conformance/incomplete-name-refusal-status",
      "kind": "implementation",
      "file": "implementation/connector-configuration-registration-conformance/incomplete-name-refusal-status.md",
      "title": "Register-connector maps a missing connector name to its stated refusal",
      "summary": "IncompleteConnectorConfigurationError is added to the shared status map so an absent or empty connector name is answered with HTTP 422 instead of the registry's unmapped 500 default, for task/connector-configuration-registration-conformance/incomplete-name-refusal-status.",
      "task": "task/connector-configuration-registration-conformance/incomplete-name-refusal-status"
    },
    {
      "id": "implementation/connector-configuration-registration-conformance/malformed-object-classification",
      "kind": "implementation",
      "file": "implementation/connector-configuration-registration-conformance/malformed-object-classification.md",
      "title": "Malformed connector-configuration values classified as not-well-formed, not incomplete",
      "summary": "registerConnector now refuses a null or array configuration value as ConnectorConfigurationNotWellFormedError instead of IncompleteConnectorConfigurationError, alongside the unparsable-text and accepted-object cases that already worked correctly.",
      "task": "task/connector-configuration-registration-conformance/malformed-object-classification"
    },
    {
      "id": "implementation/connector-configuration-registration-conformance/test-connector-parses-stored-configuration",
      "kind": "implementation",
      "file": "implementation/connector-configuration-registration-conformance/test-connector-parses-stored-configuration.md",
      "title": "Test-connector's parse-then-derive path named for this task",
      "summary": "Confirms and documents that test-connector.controller.ts already derives its issued call's method, responseMap and statusMap from the registry's stored configuration text, parsed, rather than from an assumed-already-parsed object.",
      "task": "task/connector-configuration-registration-conformance/test-connector-parses-stored-configuration"
    },
    {
      "id": "implementation/domain-boundary-scan-fix/narrow-bypass-mention-scan",
      "kind": "implementation",
      "file": "implementation/domain-boundary-scan-fix/narrow-bypass-mention-scan.md",
      "title": "Domain-boundary bypass-mention scan no longer flags a cited specification-node identity",
      "summary": "The ninth test in domain-depends-on-no-infrastructure.spec.ts narrows its http-connector bare-mention scan so a citation of a specification-node identity that merely contains that substring in its own slug no longer reports the citing file as an offender, while every other bypass mention still reports, for task/domain-boundary-scan-fix/narrow-bypass-mention-scan.",
      "task": "task/domain-boundary-scan-fix/narrow-bypass-mention-scan"
    },
    {
      "id": "implementation/observation-endings-and-collection-budget/collection-stage-propagates-remaining-budget",
      "kind": "implementation",
      "file": "implementation/observation-endings-and-collection-budget/collection-stage-propagates-remaining-budget.md",
      "title": "Collection stage propagates its remaining budget into observe-concept",
      "summary": "evidence-collection-stage.ts now hands its own seven-second-derived stage ceiling into observe-concept's remaining-budget field on its one production call site, completing the propagation the sibling task's port and adapter change left undone.",
      "task": "task/observation-endings-and-collection-budget/collection-stage-propagates-remaining-budget"
    },
    {
      "id": "implementation/observation-endings-and-collection-budget/collection-stage-records-result-detail",
      "kind": "implementation",
      "file": "implementation/observation-endings-and-collection-budget/collection-stage-records-result-detail.md",
      "title": "Collection stage copies an unavailable observation's result_detail into evidence",
      "summary": "settledEvidence now carries ObservationOutcome's own result_detail into the Evidence entry for an unavailable ending, leaving ok, denied and timeout untouched.",
      "task": "task/observation-endings-and-collection-budget/collection-stage-records-result-detail"
    },
    {
      "id": "implementation/observation-endings-and-collection-budget/observation-port-budget-clamp",
      "kind": "implementation",
      "file": "implementation/observation-endings-and-collection-budget/observation-port-budget-clamp.md",
      "title": "The observation port accepts a remaining-budget bound and the production adapter clamps its call to it",
      "summary": "IObservationSource.observeConcept now takes a caller-given remaining-budget bound, and HttpDeclarativeObservationSource bounds its one outbound HTTP call by the lesser of the capability's own declared timeout and that bound, for task/observation-endings-and-collection-budget/observation-port-budget-clamp.",
      "task": "task/observation-endings-and-collection-budget/observation-port-budget-clamp"
    },
    {
      "id": "implementation/observation-endings-and-collection-budget/observation-port-unavailable-endings",
      "kind": "implementation",
      "file": "implementation/observation-endings-and-collection-budget/observation-port-unavailable-endings.md",
      "title": "Observation port and HTTP adapter answer unavailable endings instead of throwing",
      "summary": "Widens ObservationOutcome with an optional result_detail and rewrites the four raise sites of HttpDeclarativeObservationSource observe-concept to answer unavailable data instead of throwing, issuing no HTTP call in any of the four cases, for task/observation-endings-and-collection-budget/observation-port-unavailable-endings.",
      "task": "task/observation-endings-and-collection-budget/observation-port-unavailable-endings"
    },
    {
