{
  "contract_version": "siegard-plan/3",
  "nodes": [
    {
      "id": "epic/capability-payload-notes",
      "kind": "epic",
      "file": "epic/capability-payload-notes.md",
      "title": "Capability payload notes",
      "summary": "The whole backend path of the payload_notes attribute, from a capability's registration and identity read, through the evidence snapshot taken at collection, to the judgment call and the prompt it assembles."
    },
    {
      "id": "epic/inconclusive-response-not-judgment-failure",
      "kind": "epic",
      "file": "epic/inconclusive-response-not-judgment-failure.md",
      "title": "A well-formed inconclusive model answer is not recorded as a judgment failure",
      "summary": "Corrective increment: outcomeFromModelText must record a well-formed {\"verdict\":\"inconclusive\"} model response distinctly from a response that could not be parsed, so an infrastructure failure is never conflated with a genuine domain answer."
    },
    {
      "id": "epic/register-capability-dto-refusal-order",
      "kind": "epic",
      "file": "epic/register-capability-dto-refusal-order.md",
      "title": "register-capability reaches the registry contract-completeness refusal",
      "summary": "Corrective increment: a required-attribute absence or empty string in a register-capability submission must reach the registry's own completeness check and its HTTP 422 refusal, not stop at the DTO's HTTP 400 shape validation."
    },
    {
      "id": "epic/register-capability-routes-spec-expects-stale-400s",
      "kind": "epic",
      "file": "epic/register-capability-routes-spec-expects-stale-400s.md",
      "title": "register-capability's route test asserts the registry's own refusal, not a stale 400",
      "summary": "Corrective increment: register-capability.routes.spec.ts asserts HTTP 400 for six cases register-capability-dto-refusal-order/reaches-the-registry-refusal's legitimate delivery now routes to the registry's own 422 refusal instead."
    },
    {
      "id": "epic/stale-judgment-failure-assertions-for-inconclusive",
      "kind": "epic",
      "file": "epic/stale-judgment-failure-assertions-for-inconclusive.md",
      "title": "The judgment-failure assertion for a well-formed inconclusive answer is corrected to not-grounded",
      "summary": "Corrective increment: anthropic-hypothesis-evaluator.adapter.spec.ts's test for a well-formed but inconclusive model answer asserts the now-superseded reason judgment-failure, falsified by inconclusive-response-not-judgment-failure/distinct-reason's legitimate delivery."
    },
    {
      "id": "inventory/capability-payload-notes-surface",
      "kind": "inventory",
      "file": "inventory/capability-payload-notes-surface.md",
      "title": "Capability payload_notes end-to-end surface",
      "summary": "The capability-registry, register-capability and read-capability-by-identity HTTP routes, relational capability persistence, investigation evidence snapshot, and hypothesis-judgment prompt assembly the payload_notes attribute must cross."
    },
    {
      "id": "task/capability-payload-notes/capability-declares-payload-notes",
      "kind": "task",
      "file": "task/capability-payload-notes/capability-declares-payload-notes.md",
      "title": "A capability holds its payload notes",
      "summary": "The optional payload_notes attribute on the Capability element, on the register-capability submission, and in the relation that stores a registered capability.",
      "epic": "capability-payload-notes"
    },
    {
      "id": "task/capability-payload-notes/evidence-snapshots-capability-payload-notes",
      "kind": "task",
      "file": "task/capability-payload-notes/evidence-snapshots-capability-payload-notes.md",
      "title": "Evidence snapshots the capability's payload notes",
      "summary": "The required capability_payload_notes attribute on Evidence, taken from the producing capability at the moment of collection and stored with the item.",
      "epic": "capability-payload-notes"
    },
    {
      "id": "task/capability-payload-notes/identity-read-states-payload-notes",
      "kind": "task",
      "file": "task/capability-payload-notes/identity-read-states-payload-notes.md",
      "title": "The identity read answers payload notes",
      "summary": "The read-capability-by-identity answer stating payload_notes as the registration holds it, and admitting it absent where the registration declared none.",
      "epic": "capability-payload-notes"
    },
    {
      "id": "task/capability-payload-notes/judgment-call-carries-payload-notes",
      "kind": "task",
      "file": "task/capability-payload-notes/judgment-call-carries-payload-notes.md",
      "title": "The judgment call carries the snapshotted payload notes",
      "summary": "The evidence item handed to the hypothesis evaluator carrying its own capability_payload_notes alongside its concept description and field semantics.",
      "epic": "capability-payload-notes"
    },
    {
      "id": "task/capability-payload-notes/judgment-prompt-renders-payload-notes",
      "kind": "task",
      "file": "task/capability-payload-notes/judgment-prompt-renders-payload-notes.md",
      "title": "The judgment prompt states an item's payload notes",
      "summary": "The production evaluator's prompt stating each evidence item's capability payload notes beside that item's observation, omitted where the snapshot is empty.",
      "epic": "capability-payload-notes"
    },
    {
      "id": "task/inconclusive-response-not-judgment-failure/distinct-reason",
      "kind": "task",
      "file": "task/inconclusive-response-not-judgment-failure/distinct-reason.md",
      "title": "A well-formed inconclusive model response is recorded distinctly from a judgment failure",
      "summary": "outcomeFromModelText records a well-formed {\"verdict\":\"inconclusive\"} response with reason not-grounded, never under the same \"judgment-failure\" reason a parse failure or a malformed response uses.",
      "epic": "inconclusive-response-not-judgment-failure"
    },
    {
      "id": "task/register-capability-dto-refusal-order/reaches-the-registry-refusal",
      "kind": "task",
      "file": "task/register-capability-dto-refusal-order/reaches-the-registry-refusal.md",
      "title": "A register-capability submission missing a required attribute reaches the registry's own completeness refusal",
      "summary": "Loosen register-capability.dto.ts's shape validation so an absent or empty required attribute passes the HTTP shape check and is refused by the capability registry's own 422 IncompleteCapabilityContractError instead.",
      "epic": "register-capability-dto-refusal-order"
    },
    {
      "id": "task/register-capability-routes-spec-expects-stale-400s/asserts-the-registrys-422",
      "kind": "task",
      "file": "task/register-capability-routes-spec-expects-stale-400s/asserts-the-registrys-422.md",
      "title": "The six route tests assert the registry's own 422, not a stale 400",
      "summary": "register-capability.routes.spec.ts's six now-false 400 assertions are rewritten to assert the registry's own 422 refusal and that registerCapability is reached and refuses.",
      "epic": "register-capability-routes-spec-expects-stale-400s"
    },
    {
      "id": "task/stale-judgment-failure-assertions-for-inconclusive/corrected-to-not-grounded",
      "kind": "task",
      "file": "task/stale-judgment-failure-assertions-for-inconclusive/corrected-to-not-grounded.md",
      "title": "The well-formed-inconclusive test asserts reason not-grounded, not judgment-failure",
      "summary": "anthropic-hypothesis-evaluator.adapter.spec.ts's test for a well-formed inconclusive model answer is rewritten to assert the reason the production adapter now actually returns.",
      "epic": "stale-judgment-failure-assertions-for-inconclusive"
    }
  ],
