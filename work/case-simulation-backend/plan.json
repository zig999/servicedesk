  "nodes": [
    {
      "id": "epic/case-simulation-pipeline",
      "kind": "epic",
      "file": "epic/case-simulation-pipeline.md",
      "title": "Shared investigation pipeline and the simulate HTTP surface",
      "summary": "The stage extraction shared between diagnose and simulate, the no-cache simulation composition, and the two new simulate-case/simulate-hypothesis HTTP operations."
    },
    {
      "id": "epic/diagnose-release-gate",
      "kind": "epic",
      "file": "epic/diagnose-release-gate.md",
      "title": "The release gate on diagnose",
      "summary": "diagnose refuses a case version still in draft state, naming that it is not released, per decision D6."
    },
    {
      "id": "epic/investigation-telemetry",
      "kind": "epic",
      "file": "epic/investigation-telemetry.md",
      "title": "Instrumented judgment, consolidation and cost",
      "summary": "The judgment/consolidation ports, their Anthropic and fake adapters, evidence's own elapsed_ms, and diagnose's own switch from placeholder to real cost and durations."
    },
    {
      "id": "inventory/investigation-pipeline-and-http-surface",
      "kind": "inventory",
      "file": "inventory/investigation-pipeline-and-http-surface.md",
      "title": "Investigation pipeline, judgment/consolidation ports, and diagnose HTTP surface",
      "summary": "The one pipeline (run-diagnosis.ts) and its composition roots, ports/adapters and HTTP wiring that simulate-case, simulate-hypothesis and the diagnose release gate must extend rather than duplicate."
    },
    {
      "id": "task/case-simulation-pipeline/extract-shared-investigation-pipeline",
      "kind": "task",
      "file": "task/case-simulation-pipeline/extract-shared-investigation-pipeline.md",
      "title": "Extract the shared investigation pipeline",
      "summary": "buildSubject through draftAssessment become one function returning the complete record, called by diagnose (which adds buildInvestigation and writeWithinDeadline) and, later, by simulate.",
      "epic": "case-simulation-pipeline"
    },
    {
      "id": "task/case-simulation-pipeline/no-cache-simulation-composition",
      "kind": "task",
      "file": "task/case-simulation-pipeline/no-cache-simulation-composition.md",
      "title": "A no-cache composition for simulation",
      "summary": "A factory parallel to production-diagnose.factory.ts assembles a simulation's observation source with no cache layer, by construction, so nothing a simulation collects can ever enter a cache.",
      "epic": "case-simulation-pipeline"
    },
    {
      "id": "task/case-simulation-pipeline/simulate-case-operation",
      "kind": "task",
      "file": "task/case-simulation-pipeline/simulate-case-operation.md",
      "title": "POST /v1/simulate returns the complete record without writing an investigation",
      "summary": "The simulate-case DTO, route and controller run the shared pipeline over a case version in either state and return evidence, evaluations, resolved outcome, assessment, cost and durations.",
      "epic": "case-simulation-pipeline"
    },
    {
      "id": "task/case-simulation-pipeline/simulate-hypothesis-operation",
      "kind": "task",
      "file": "task/case-simulation-pipeline/simulate-hypothesis-operation.md",
      "title": "POST /v1/simulate/hypothesis returns one hypothesis's own evaluation",
      "summary": "The simulate-hypothesis DTO, route and controller restrict collection to one named hypothesis's own revision and return exactly one evaluation, with no outcome or assessment resolved.",
      "epic": "case-simulation-pipeline"
    },
    {
      "id": "task/diagnose-release-gate/refuse-diagnosis-of-a-draft-case-version",
      "kind": "task",
      "file": "task/diagnose-release-gate/refuse-diagnosis-of-a-draft-case-version.md",
      "title": "diagnose refuses a draft-state case version",
      "summary": "A new named domain error refuses a diagnose request pinned to a draft-state case version, registered in status-map.ts, before the engine ever runs.",
      "epic": "diagnose-release-gate"
    },
    {
      "id": "task/investigation-telemetry/anthropic-adapters-report-real-usage-and-timing",
      "kind": "task",
      "file": "task/investigation-telemetry/anthropic-adapters-report-real-usage-and-timing.md",
      "title": "Anthropic adapters report the provider's own usage, timing and prompt",
      "summary": "anthropic-hypothesis-evaluator.adapter.ts and anthropic-assessment-consolidator.adapter.ts read message.usage, measure elapsed time and return the materialized prompt instead of discarding them.",
      "epic": "investigation-telemetry"
    },
    {
      "id": "task/investigation-telemetry/diagnose-reports-real-cost-and-durations",
      "kind": "task",
      "file": "task/investigation-telemetry/diagnose-reports-real-cost-and-durations.md",
      "title": "diagnose writes real cost and durations",
      "summary": "diagnose.controller.ts stops writing UNMEASURED_COST/UNMEASURED_DURATIONS and writes what the investigation actually cost and took.",
      "epic": "investigation-telemetry"
    },
    {
      "id": "task/investigation-telemetry/evidence-collection-measures-elapsed-ms",
      "kind": "task",
      "file": "task/investigation-telemetry/evidence-collection-measures-elapsed-ms.md",
      "title": "Evidence carries its own collection elapsed_ms",
      "summary": "evidence-collection-stage.ts records how long each concept's own collection attempt took, on every Evidence item it assembles.",
      "epic": "investigation-telemetry"
    },
    {
      "id": "task/investigation-telemetry/fake-adapters-return-zeroed-usage-and-timing",
      "kind": "task",
      "file": "task/investigation-telemetry/fake-adapters-return-zeroed-usage-and-timing.md",
      "title": "Fake adapters return zero-valued usage and timing",
      "summary": "fake-hypothesis-evaluator.adapter.ts and fake-assessment-consolidator.adapter.ts satisfy the widened ports with deterministic zeros.",
      "epic": "investigation-telemetry"
    },
    {
      "id": "task/investigation-telemetry/widen-judgment-and-consolidation-ports",
      "kind": "task",
      "file": "task/investigation-telemetry/widen-judgment-and-consolidation-ports.md",
      "title": "Widen the judgment and consolidation ports to carry usage, elapsed time and prompt",
      "summary": "IHypothesisEvaluator and IAssessmentConsolidator declare usage/elapsed_ms/prompt, and the judgment stage attaches them onto each Evaluation a call produced.",
      "epic": "investigation-telemetry"
    }
  ],
