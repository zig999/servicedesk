  "contract_version": "siegard-delivery/2",
  "nodes": [
    {
      "id": "implementation/openapi-document-operations-read/document-operations-reading",
      "kind": "implementation",
      "file": "implementation/openapi-document-operations-read/document-operations-reading.md",
      "title": "The domain reading behind read-openapi-document-operations",
      "summary": "A new connector-registry unit fetches an operator-named OpenAPI document link through the existing IOpenApiDocumentFetcher port, parses it through the shared parse step, and answers every path-item operation it declares as a path-and-upper-cased-method pair, or lets the fetch or parse refusal already raised by those units propagate unchanged.",
      "task": "task/openapi-document-operations-read/document-operations-reading"
    },
    {
      "id": "implementation/openapi-document-operations-read/read-operations-http-operation",
      "kind": "implementation",
      "file": "implementation/openapi-document-operations-read/read-operations-http-operation.md",
      "title": "Publish read-openapi-document-operations over HTTP",
      "summary": "Adds the routes/controller/dto triplet for read-openapi-document-operations and wires it into build-app.ts and build-app.factory.ts, reusing the existing document-operations reading, the shared OpenApiDocumentFetcher adapter, and the already-mapped 422 refusals with no change to status-map.ts.",
      "task": "task/openapi-document-operations-read/read-operations-http-operation"
    },
    {
      "id": "implementation/openapi-document-operations-read/shared-openapi-document-parse-step",
      "kind": "implementation",
      "file": "implementation/openapi-document-operations-read/shared-openapi-document-parse-step.md",
      "title": "Extract the OpenAPI parse-and-version-refusal step into a shared unit",
      "summary": "A new readOpenApiDocument unit in connector-registry holds the JSON-then-YAML parse and the OpenAPI 3.x version refusal (including a paths-shape well-formedness check), and readOpenApiOperation now delegates to it instead of holding that logic itself.",
      "task": "task/openapi-document-operations-read/shared-openapi-document-parse-step"
    },
    {
      "id": "proof/openapi-document-operations-read/document-operations-reading",
      "kind": "proof",
      "file": "proof/openapi-document-operations-read/document-operations-reading.md",
      "title": "Proof of the domain reading behind read-openapi-document-operations",
      "summary": "Proves the backend reading that fetches an operator-named OpenAPI document through IOpenApiDocumentFetcher, parses it through the shared parse step, and answers every declared path/method operation whole or lets a fetch or parse refusal propagate unchanged.",
      "task": "task/openapi-document-operations-read/document-operations-reading"
    },
    {
      "id": "proof/openapi-document-operations-read/read-operations-http-operation",
      "kind": "proof",
      "file": "proof/openapi-document-operations-read/read-operations-http-operation.md",
      "title": "Publish read-openapi-document-operations over HTTP — proof",
      "summary": "New unit tests over the routes/controller/dto triplet and one added wiring-reachability row prove the read's happy path, its value-object shape, its method-casing invariant, its request validation, and its two distinguished 422 refusals; a required plumbing fix to an existing stub is disclosed separately from the assertions.",
      "task": "task/openapi-document-operations-read/read-operations-http-operation"
    },
    {
      "id": "proof/openapi-document-operations-read/shared-openapi-document-parse-step",
      "kind": "proof",
      "file": "proof/openapi-document-operations-read/shared-openapi-document-parse-step.md",
      "title": "The extracted OpenAPI parse-and-version-refusal unit, tested directly, with the draft operation's preserved behavior evidenced from the tests already standing over it",
      "summary": "Five new tests exercise readOpenApiDocument's own contract directly (whole-document return, both parse failures, both version refusals, the new paths well-formedness check), and the unmodified openapi-operation-reader and draft-connector-configuration-from-openapi suites are cited as the standing evidence that the draft operation's behavior is unchanged.",
      "task": "task/openapi-document-operations-read/shared-openapi-document-parse-step"
    },
    {
      "id": "review/connector-configuration-helper-operation-listing-backend",
      "kind": "review",
      "file": "review/connector-configuration-helper-operation-listing-backend.md",
      "title": "Configuration Helper operation listing — backend review",
      "summary": "Reviews the three tasks of epic openapi-document-operations-read: extracting the shared OpenAPI parse/version-refusal step, the operations-read domain reading, and its HTTP publication.",
      "ran": [
        "coverage",
        "conformance",
        "standard"
      ],
      "unproven": [
        "No error class, message or context readOpenApiOperation previously raised is renamed, retyped or dropped.",
        "The controller maps the validated DTO and its injected dependencies onto the reading and holds no logic of its own.",
        "The document fetch is issued inside this backend reading through IOpenApiDocumentFetcher, and the reading offers no parameter by which a caller supplies already-fetched document text.",
        "The fetch is abandoned as a timeout where the named link has not answered within 60000 milliseconds, delivered by the existing IOpenApiDocumentFetcher port rather than by a second timeout introduced here.",
        "The operation registers nothing and issues no register-connector call.",
        "The reading generates no connector configuration draft and issues no register-connector call.",
        "The reading parses through the unit task/openapi-document-operations-read/shared-openapi-document-parse-step established, holding no parse or version-refusal code of its own.",
        "readOpenApiOperation obtains its parsed document from that unit and holds no parsing, version-checking or version-refusal code of its own."
      ],
      "findings": 2
    }
  ],
