{
  "contract_version": "siegard-plan/3",
  "nodes": [
    {
      "id": "epic/assessment-drafting",
      "kind": "epic",
      "file": "epic/assessment-drafting.md",
      "title": "Assessment resolution and drafting",
      "summary": "Resolves the case's outcome over the completed evaluations and drafts the assessment's text from exactly the input that outcome admits."
    },
    {
      "id": "epic/evidence-collection",
      "kind": "epic",
      "file": "epic/evidence-collection.md",
      "title": "Evidence collection",
      "summary": "Parallel, scoped, budgeted collection of one evidence per concept in the pinned case's plan, behind a new observation-source port and its fake test adapter."
    },
    {
      "id": "epic/hypothesis-judgment",
      "kind": "epic",
      "file": "epic/hypothesis-judgment.md",
      "title": "Hypothesis judgment",
      "summary": "Isolated, deadline-bounded, cited judgment of every hypothesis a pinned case requires, behind the hypothesis-evaluator port and its fake test adapter."
    },
    {
      "id": "epic/investigation-lifecycle",
      "kind": "epic",
      "file": "epic/investigation-lifecycle.md",
      "title": "Investigation lifecycle",
      "summary": "Builds the immutable, pinned investigation from every stage's output, writes it once, honors the idempotency window, and wires the whole synchronous diagnose entry point that responds only after the write and publishes InvestigationCompleted only after that."
    },
    {
      "id": "inventory/investigation-engine",
      "kind": "inventory",
      "file": "inventory/investigation-engine.md",
      "title": "Investigation engine's landing area",
      "summary": "A greenfield module beside case and capability-registry, consuming the published case-query and capability-registry reads without touching the knowledge context."
    },
    {
      "id": "task/assessment-drafting/draft-assessment-text",
      "kind": "task",
      "file": "task/assessment-drafting/draft-assessment-text.md",
      "title": "Draft the assessment's text from the narrowed input",
      "summary": "Produces the one field drafting is responsible for — the assessment's text — from the narrowed input alone.",
      "epic": "assessment-drafting"
    },
    {
      "id": "task/assessment-drafting/resolve-and-narrow-input",
      "kind": "task",
      "file": "task/assessment-drafting/resolve-and-narrow-input.md",
      "title": "Resolve the outcome and narrow the writing input",
      "summary": "Resolves the case's outcome over the completed evaluations and assembles exactly the input the writing step may see.",
      "epic": "assessment-drafting"
    },
    {
      "id": "task/evidence-collection/evidence-collection-stage",
      "kind": "task",
      "file": "task/evidence-collection/evidence-collection-stage.md",
      "title": "Parallel, budgeted evidence collection over the case's plan",
      "summary": "Collects one evidence per concept in the pinned case's collection plan, in parallel, within the requester's scope and the collection stage's own budget.",
      "epic": "evidence-collection"
    },
    {
      "id": "task/evidence-collection/observation-source-port",
      "kind": "task",
      "file": "task/evidence-collection/observation-source-port.md",
      "title": "Observation-source port and its fake adapter",
      "summary": "The port the collection stage calls to observe one concept for one subject, plus a test adapter that returns controlled results without a real connector.",
      "epic": "evidence-collection"
    },
    {
      "id": "task/hypothesis-judgment/citation-validation",
      "kind": "task",
      "file": "task/hypothesis-judgment/citation-validation.md",
      "title": "Structural validation of an evaluator's citations",
      "summary": "A pure check that every citation an evaluator's response names belongs to the judged hypothesis's collects and points at a field the citing evidence's capability actually declares.",
      "epic": "hypothesis-judgment"
    },
    {
      "id": "task/hypothesis-judgment/hypothesis-evaluator-port",
      "kind": "task",
      "file": "task/hypothesis-judgment/hypothesis-evaluator-port.md",
      "title": "Hypothesis-evaluator port and its fake adapter",
      "summary": "The port through which one hypothesis is judged against its own evidence, plus a fake adapter returning controlled verdicts for tests.",
      "epic": "hypothesis-judgment"
    },
    {
      "id": "task/hypothesis-judgment/judgment-stage",
      "kind": "task",
      "file": "task/hypothesis-judgment/judgment-stage.md",
      "title": "Isolated, deadline-bounded judgment of every required hypothesis",
      "summary": "Judges every hypothesis the pinned case requires, one isolated parallel call each, retrying once on an invalid citation set when the deadline still allows it and falling back to inconclusive otherwise.",
      "epic": "hypothesis-judgment"
    },
    {
      "id": "task/investigation-lifecycle/diagnose-entry-point",
      "kind": "task",
      "file": "task/investigation-lifecycle/diagnose-entry-point.md",
      "title": "The synchronous diagnose entry point",
      "summary": "Wires case pinning, deadline propagation, collection, judgment, resolution and drafting, the investigation factory, its write-once storage and the idempotency window into the one synchronous diagnose operation, publishing InvestigationCompleted only after the write succeeds.",
      "epic": "investigation-lifecycle"
    },
    {
      "id": "task/investigation-lifecycle/idempotency-window",
      "kind": "task",
      "file": "task/investigation-lifecycle/idempotency-window.md",
      "title": "Idempotency window over subject, case and ticket",
      "summary": "A lease-backed mechanism that lets a repeated request within the configured window find the investigation already completed or in progress, and starts a new one only when neither exists.",
      "epic": "investigation-lifecycle"
    },
    {
      "id": "task/investigation-lifecycle/investigation-factory",
      "kind": "task",
      "file": "task/investigation-lifecycle/investigation-factory.md",
      "title": "The immutable investigation factory",
      "summary": "Builds the whole, pinned, invariant-checked Investigation from a subject, the pinned case's replay data, collected evidence, completed evaluations, the resolved assessment, cost and durations.",
      "epic": "investigation-lifecycle"
    },
    {
      "id": "task/investigation-lifecycle/investigation-store",
      "kind": "task",
      "file": "task/investigation-lifecycle/investigation-store.md",
      "title": "Write-once investigation storage",
      "summary": "Persists one investigation as its own file, never overwriting or mutating a record once written, mirroring the case module's file-backed store pattern.",
      "epic": "investigation-lifecycle"
    }
  ],
