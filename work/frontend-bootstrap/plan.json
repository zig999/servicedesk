{
  "contract_version": "siegard-plan/3",
  "nodes": [
    {
      "id": "epic/case-authoring-console",
      "kind": "epic",
      "file": "epic/case-authoring-console.md",
      "title": "Frontend case-authoring console substrate",
      "summary": "The build, lint, style, type and test tooling frontend/app needs before any case-authoring screen exists, under the epic that claims this initiative's territory in the case-authoring domain."
    },
    {
      "id": "epic/cases-list-and-detail",
      "kind": "epic",
      "file": "epic/cases-list-and-detail.md",
      "title": "Cases List and Case Detail",
      "summary": "The two real, data-driven read screens Onda 2 lands over Onda 1's foundation -- a searchable list of every case and a per-case version timeline -- replacing CasesListPlaceholder and CaseDetailPlaceholder. Originating a new draft is deferred to Onda 3 (see Notes)."
    },
    {
      "id": "epic/frontend-console-foundation",
      "kind": "epic",
      "file": "epic/frontend-console-foundation.md",
      "title": "Frontend console cross-cutting foundation",
      "summary": "The app shell, router skeleton, typed API client, error-to-UI-state mapping, and the shared components (conflict banner, telemetry hook, reusable status table, query client and toaster) that this wave builds before any case-authoring, glossary or capabilities screen exists."
    },
    {
      "id": "epic/version-editor",
      "kind": "epic",
      "file": "epic/version-editor.md",
      "title": "Version Editor",
      "summary": "The full-replace draft-editing form (PATCH, with its own clean/dirty/saving/conflict state machine and 404/409 handling) plus the New Draft origination flow deferred from Onda 2, sharing one field form that differs only in which verb Save dispatches."
    },
    {
      "id": "inventory/frontend-app-bootstrap-onda-1",
      "kind": "inventory",
      "file": "inventory/frontend-app-bootstrap-onda-1.md",
      "title": "Frontend app substrate and TUI catalog before Onda 1's foundation",
      "summary": "The target root builds, lints and renders one TUI component through the @tui/ui alias, but has no router, query layer, app shell, sidebar/nav, or screen; TUI's own catalog already ships the table, alert/banner and breadcrumb primitives this wave would otherwise rebuild, and the backend's error envelope and status map are the one contract the new API client must match."
    },
    {
      "id": "inventory/frontend-app-substrate",
      "kind": "inventory",
      "file": "inventory/frontend-app-substrate.md",
      "title": "Frontend app substrate landing zone",
      "summary": "frontend/app is an empty greenfield tree; the only relevant existing material is the vendored, read-only TUI submodule the scope requires composing through a @tui/ui/* alias."
    },
    {
      "id": "inventory/frontend-cases-list-detail-foundation",
      "kind": "inventory",
      "file": "inventory/frontend-cases-list-detail-foundation.md",
      "title": "Onda 1 foundation the Cases List and Case Detail screens land on",
      "summary": "A router, an AppShell, a typed API client, an error-to-UI-state table, a reusable StatusTable, a QueryClient/Toaster, a telemetry hook and a ConflictBanner already exist under frontend/app/src; Onda 2 replaces two of the router's ten placeholder routes with real, data-driven screens on top of them."
    },
    {
      "id": "inventory/version-editor-foundation",
      "kind": "inventory",
      "file": "inventory/version-editor-foundation.md",
      "title": "Version Editor build surface, over the Onda 1/2 foundation and the real backend contract",
      "summary": "What the Version Editor (plus the folded-in New Draft form) can reuse from the delivered foundation, and the exact backend shapes, vocabularies and error bodies it must match."
    },
    {
      "id": "task/case-authoring-console/build-substrate",
      "kind": "task",
      "file": "task/case-authoring-console/build-substrate.md",
      "title": "Build frontend app substrate",
      "summary": "The manifest, compiler, lint, build, style and end-to-end test configuration the frontend standard presupposes and the empty frontend/app tree does not hold, plus the minimal shell that proves the TUI import chain resolves.",
      "epic": "case-authoring-console"
    },
    {
      "id": "task/cases-list-and-detail/case-detail-timeline",
      "kind": "task",
      "file": "task/cases-list-and-detail/case-detail-timeline.md",
      "title": "Case Detail version timeline",
      "summary": "Replaces CaseDetailPlaceholder with a read-only rendering of a case's version timeline from GET /v1/cases/:slug/versions, offering \"Continue editing\" on a draft version with no additional precondition.",
      "epic": "cases-list-and-detail"
    },
    {
      "id": "task/cases-list-and-detail/cases-list-screen",
      "kind": "task",
      "file": "task/cases-list-and-detail/cases-list-screen.md",
      "title": "Cases List screen",
      "summary": "Replaces CasesListPlaceholder with a table listing every case from GET /v1/cases, with a search/filter control, an empty state, and per-row navigation to Case Detail.",
      "epic": "cases-list-and-detail"
    },
    {
      "id": "task/cases-list-and-detail/dev-proxy-for-backend-api",
      "kind": "task",
      "file": "task/cases-list-and-detail/dev-proxy-for-backend-api.md",
      "title": "Dev-server proxy to the real backend",
      "summary": "A vite.config.ts server.proxy entry forwarding /v1/* to the real backend at http://localhost:3000, so a browser-side apiFetch call reaches it without a CORS rejection.",
      "epic": "cases-list-and-detail"
    },
    {
      "id": "task/frontend-console-foundation/app-shell",
      "kind": "task",
      "file": "task/frontend-console-foundation/app-shell.md",
      "title": "AppShell sidebar, topbar breadcrumb and no-auth indicator",
      "summary": "The persistent shell composing a sidebar (Cases, Glossary, Capabilities, no top-level Hypotheses) and a topbar with a route-derived breadcrumb through TUI's Breadcrumb primitive and a fixed \"No auth in this build\" indicator.",
      "epic": "frontend-console-foundation"
    },
    {
      "id": "task/frontend-console-foundation/conflict-banner",
      "kind": "task",
      "file": "task/frontend-console-foundation/conflict-banner.md",
      "title": "Reusable conflict banner",
      "summary": "A reusable conflict banner composed over TUI's Banner primitive (frame, accent, titleLevel, action slots), distinct from Alert's inline role, for the proposal's section 2.3 conflict messaging.",
      "epic": "frontend-console-foundation"
    },
    {
      "id": "task/frontend-console-foundation/error-to-ui-state-table",
      "kind": "task",
      "file": "task/frontend-console-foundation/error-to-ui-state-table.md",
      "title": "Error class to UI-state mapping table",
      "summary": "The API-02 table resolving each of the ten mapped backend error classes and the four unmapped classes' shared generic-500 fallback to a UI state, keyed off ApiError.code and src/src/errors/status-map.ts's class names.",
      "epic": "frontend-console-foundation"
    },
    {
      "id": "task/frontend-console-foundation/query-client-and-toaster",
      "kind": "task",
      "file": "task/frontend-console-foundation/query-client-and-toaster.md",
      "title": "Global query client and single toaster mount",
      "summary": "A module-level @tanstack/react-query QueryClient (retry:1, a QueryCache-level onError that fires a sonner toast, staleTime left to each query) wrapping the app, and the one sonner Toaster mounted inside the AppShell.",
      "epic": "frontend-console-foundation"
    },
    {
      "id": "task/frontend-console-foundation/reusable-status-table",
      "kind": "task",
      "file": "task/frontend-console-foundation/reusable-status-table.md",
      "title": "Reusable clickable-row status table",
      "summary": "A reusable table with a clickable row and a status column always rendered as color plus word, composed over TUI's Table primitive, for reuse by Cases List, Glossary and Capabilities.",
      "epic": "frontend-console-foundation"
    },
    {
      "id": "task/frontend-console-foundation/router-skeleton",
      "kind": "task",
      "file": "task/frontend-console-foundation/router-skeleton.md",
      "title": "Route tree skeleton for the ten proposal screens",
      "summary": "An empty @tanstack/react-router route tree with one placeholder route per screen 2.1 through 2.10, with no layout composed yet.",
      "epic": "frontend-console-foundation"
    },
    {
      "id": "task/frontend-console-foundation/telemetry-catalog-hook",
      "kind": "task",
      "file": "task/frontend-console-foundation/telemetry-catalog-hook.md",
      "title": "Telemetry event catalog hook",
      "summary": "A hook exposing the eight-event telemetry catalog from section 3 of the proposal, sinking each call to namespaced console.info per the decision recorded in temp/frontend-console-decisions.md.",
      "epic": "frontend-console-foundation"
    },
    {
      "id": "task/frontend-console-foundation/typed-api-client",
      "kind": "task",
      "file": "task/frontend-console-foundation/typed-api-client.md",
      "title": "Typed fetch client over the backend's error envelope",
      "summary": "A fetch wrapper that parses the backend's {error:{code,message,details?}} envelope into a typed ApiError, matching src/src/http/error-handler.middleware.ts.",
      "epic": "frontend-console-foundation"
    },
    {
      "id": "task/version-editor/edit-draft-version",
      "kind": "task",
      "file": "task/version-editor/edit-draft-version.md",
      "title": "Edit an existing draft version",
      "summary": "Replaces CaseVersionPlaceholder with a full-replace PATCH form over an existing draft's title, when_to_use, fixed subject, consolidation_register and glossary-backed fallback outcome/referral, driven by a clean/dirty/saving/conflict save state machine.",
      "epic": "version-editor"
    },
    {
      "id": "task/version-editor/new-draft-creation",
      "kind": "task",
      "file": "task/version-editor/new-draft-creation.md",
      "title": "Originate a new draft from Case Detail",
      "summary": "Adds the \"New draft\" entry point to Case Detail, opening the same field form in a blank state whose first Save calls POST /v1/cases rather than PATCH, handling the 409 CaseAlreadyHasDraftError race and the empty-manifest read-back gap.",
      "epic": "version-editor"
    }
  ],
