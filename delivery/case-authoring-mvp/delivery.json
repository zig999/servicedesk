{
  "contract_version": "siegard-delivery/2",
  "nodes": [
    {
      "id": "implementation/capability-registry/capability-registration",
      "kind": "implementation",
      "file": "implementation/capability-registry/capability-registration.md",
      "title": "Capability registration with a held read-only contract over plain JSON files",
      "summary": "register-capability refuses any registration whose nature is not read-only or whose declared contract is incomplete, defaults an unstated timeout to 60000 milliseconds, and persists every held registration as a plain JSON file behind a store port.",
      "task": "task/capability-registry/capability-registration"
    },
    {
      "id": "implementation/capability-registry/capability-resolution",
      "kind": "implementation",
      "file": "implementation/capability-registry/capability-resolution.md",
      "title": "Capability resolution as the published one-to-one read over the registry",
      "summary": "read-capability resolves a concept to the one capability currently answering it, whole and as currently registered, reporting an unanswered concept as data — and the registry now guarantees the one-to-one by refusing, before any write, a registration whose concept a different capability identity already answers.",
      "task": "task/capability-registry/capability-resolution"
    },
    {
      "id": "implementation/published-language/build-substrate",
      "kind": "implementation",
      "file": "implementation/published-language/build-substrate.md",
      "title": "Build substrate for the backend target",
      "summary": "The manifest, strict compiler configuration and flat lint configuration the project's standard presupposes, arranged over the greenfield tree so every declared step completes and no database driver is declared.",
      "task": "task/published-language/build-substrate"
    },
    {
      "id": "implementation/published-language/glossary-query",
      "kind": "implementation",
      "file": "implementation/published-language/glossary-query.md",
      "title": "Published glossary-query read",
      "summary": "The published IGlossaryQuery contract — readVocabularyTerm and readConcept — provided by the existing glossary holding and wired through the module's factory, answering every read from the store's current records and every absence as typed data.",
      "task": "task/published-language/glossary-query"
    },
    {
      "id": "implementation/published-language/glossary-vocabulary",
      "kind": "implementation",
      "file": "implementation/published-language/glossary-vocabulary.md",
      "title": "Glossary vocabulary as data behind a store port",
      "summary": "The four term vocabularies and the concepts as pure domain values whose plain-JSON persistence reaches them only through a domain-declared port, with uniqueness, the sixty-second ttl default and the two non-conclusion outcomes guaranteed by the glossary's holding.",
      "task": "task/published-language/glossary-vocabulary"
    },
    {
      "id": "proof/capability-registry/capability-registration",
      "kind": "proof",
      "file": "proof/capability-registry/capability-registration.md",
      "title": "Proof for capability registration",
      "summary": "What proves task/capability-registry/capability-registration — the registry's refusals, the sixty-second default held as 60000 milliseconds, the plain-JSON persistence, and the exclusions the task's two UNDERDETERMINED notes require.",
      "task": "task/capability-registry/capability-registration"
    },
    {
      "id": "proof/capability-registry/capability-resolution",
      "kind": "proof",
      "file": "proof/capability-registry/capability-resolution.md",
      "title": "Proof for capability resolution",
      "summary": "What proves task/capability-registry/capability-resolution — the published read answering each concept's one capability whole and current, the absence as data, and the one-to-one guarded at registration and at read so no priority chain can hide behind the four criteria.",
      "task": "task/capability-registry/capability-resolution"
    },
    {
      "id": "proof/published-language/glossary-query",
      "kind": "proof",
      "file": "proof/published-language/glossary-query.md",
      "title": "Proof for the glossary query",
      "summary": "What proves task/published-language/glossary-query, exercising the published IGlossaryQuery contract over a mutable in-memory store for resolution and over the real file store for freshness.",
      "task": "task/published-language/glossary-query"
    },
    {
      "id": "proof/published-language/glossary-vocabulary",
      "kind": "proof",
      "file": "proof/published-language/glossary-vocabulary.md",
      "title": "Proof for the glossary vocabulary",
      "summary": "What proves task/published-language/glossary-vocabulary — the unique-name refusals, the concept shape and its sixty-second default, the seeded non-conclusion outcomes, the plain-JSON persistence, and the two import audits, including the one the UNDERDETERMINED note demands.",
      "task": "task/published-language/glossary-vocabulary"
    }
