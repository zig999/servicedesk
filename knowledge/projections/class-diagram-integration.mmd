classDiagram
    namespace CapabilityAggregate {
        class Capability {
            <<AggregateRoot>>
            +string name
            +string version
            +CapabilityNature nature
            +string inputSchema
            +string outputSchema
            +integer timeout
            +string connector
            +Concept concept
        }
    }
    class CapabilityNature {
        <<Enumeration>>
        READ_ONLY
        MUTATING
    }
    class CapabilityRegistry {
        <<Service>>
        +registerCapability()
        +resolveConcept()
    }
    class Concept {
        <<external: glossary>>
    }
