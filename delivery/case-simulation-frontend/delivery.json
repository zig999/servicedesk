      "file": "implementation/subject-derivation/use-simulation-subject-hook.md",
      "title": "use-simulation-subject hook",
      "summary": "A pure derivation service module plus a new hooks/use-simulation-subject.ts that resolves a case version's collection plan through the capability and connector-configuration registries into required subject fields, merges them with curator-added attributes and the requester, and reports readiness.",
      "task": "task/subject-derivation/use-simulation-subject-hook"
    },
