{
  "contract_version": "siegard-plan/3",
  "nodes": [
    {
      "id": "epic/case-lifecycle-domain-model",
      "kind": "epic",
      "file": "epic/case-lifecycle-domain-model.md",
      "title": "The case-version aggregate's own types and structural validation",
      "summary": "Hypothesis identity separated from its revisioned content, the manifest entry that pins one revision at one position, and the case-version type carrying state and released_at — plus the structural, at-every-read checks over that shape."
    },
    {
      "id": "epic/case-lifecycle-operations",
      "kind": "epic",
      "file": "epic/case-lifecycle-operations.md",
      "title": "The six published case-lifecycle operations",
      "summary": "create-draft, revise-hypothesis, place-hypothesis, remove-hypothesis, release and discard, each granular enough to apply its own cardinality rule at its own moment, replacing the one retired author-case-version command."
    },
    {
      "id": "epic/case-lifecycle-persistence",
      "kind": "epic",
      "file": "epic/case-lifecycle-persistence.md",
      "title": "The relational substrate for the draft/released lifecycle",
      "summary": "The schema and the relational store adapter that give a case version a draft/released state, a durable version counter, hypothesis identity split from revisioned content, and the manifest that joins a version to the revisions it adopts."
    },
    {
      "id": "epic/diagnosis-release-gate",
      "kind": "epic",
      "file": "epic/diagnosis-release-gate.md",
      "title": "The released-only diagnosis gate",
      "summary": "The one new check on the diagnosis path — a case version pinned for investigation must be released, never a draft."
    },
    {
      "id": "inventory/case-lifecycle-area",
      "kind": "inventory",
      "file": "inventory/case-lifecycle-area.md",
      "title": "Case module, its relational persistence and the diagnose gate point",
      "summary": "Where the draft/released split lands — the single Case/Hypothesis aggregate, its relational store, the two authoring/reading services built on it, and the diagnose entry point that will need the new released-only gate."
    },
    {
      "id": "task/case-lifecycle-domain-model/aggregate-types-and-structural-validation",
      "kind": "task",
      "file": "task/case-lifecycle-domain-model/aggregate-types-and-structural-validation.md",
      "title": "Case-version aggregate types and structural validation for the draft/released split",
      "summary": "case.ts's types and parse-case-document.ts's structural checks updated so a hypothesis's stable identity, its revisioned content and its manifest position are three distinct facts, and the version itself carries state and released_at.",
      "epic": "case-lifecycle-domain-model"
    },
    {
      "id": "task/case-lifecycle-operations/create-draft-operation",
      "kind": "task",
      "file": "task/case-lifecycle-operations/create-draft-operation.md",
      "title": "create-draft operation",
      "summary": "Originates a new draft version for a case, either from its own latest released version or from a named historical version, honoring the at-most-one-draft and never-reused-number rules.",
      "epic": "case-lifecycle-operations"
    },
    {
      "id": "task/case-lifecycle-operations/discard-operation",
      "kind": "task",
      "file": "task/case-lifecycle-operations/discard-operation.md",
      "title": "discard operation",
      "summary": "Removes a draft version and its own manifest entries, refusing a version that is not in draft state, never removing a hypothesis-revision.",
      "epic": "case-lifecycle-operations"
    },
    {
      "id": "task/case-lifecycle-operations/manifest-composition-operations",
      "kind": "task",
      "file": "task/case-lifecycle-operations/manifest-composition-operations.md",
      "title": "place-hypothesis and remove-hypothesis operations",
      "summary": "Composes a draft version's own manifest — placing a hypothesis-revision at a position, or removing an entry — refusing outside draft state and refusing an emptied manifest.",
      "epic": "case-lifecycle-operations"
    },
    {
      "id": "task/case-lifecycle-operations/release-operation",
      "kind": "task",
      "file": "task/case-lifecycle-operations/release-operation.md",
      "title": "release operation",
      "summary": "Runs the same structural and coherence validation read-case already runs over the assembled case, and only once every rule holds, marks the draft released and records the instant.",
      "epic": "case-lifecycle-operations"
    },
    {
      "id": "task/case-lifecycle-operations/revise-hypothesis-operation",
      "kind": "task",
      "file": "task/case-lifecycle-operations/revise-hypothesis-operation.md",
      "title": "revise-hypothesis operation",
      "summary": "Creates a new hypothesis-revision — and the hypothesis's own identity, the first time its name is used — never altering an existing revision and never touching any manifest.",
      "epic": "case-lifecycle-operations"
    },
    {
      "id": "task/case-lifecycle-operations/wire-and-retire-author-case-version",
      "kind": "task",
      "file": "task/case-lifecycle-operations/wire-and-retire-author-case-version.md",
      "title": "Wire the case-lifecycle operations and retire author-case-version",
      "summary": "Wires create-draft, revise-hypothesis, place-hypothesis, remove-hypothesis, release and discard into one composition root, and retires AuthorCaseVersionService, IAuthorCaseVersion and author-case-version.factory.ts.",
      "epic": "case-lifecycle-operations"
    },
    {
      "id": "task/case-lifecycle-persistence/case-version-lifecycle-schema",
      "kind": "task",
      "file": "task/case-lifecycle-persistence/case-version-lifecycle-schema.md",
      "title": "Case-version lifecycle schema migration",
      "summary": "A new, sequentially-numbered migration script (or scripts) that gives case_versions a state and released_at, cases a durable version counter, and splits hypothesis identity from its revisioned content behind a manifest — while fixing migration 0006's blanket update refusal so a draft row stays writable.",
      "epic": "case-lifecycle-persistence"
    },
    {
      "id": "task/case-lifecycle-persistence/relational-case-store-for-lifecycle",
      "kind": "task",
      "file": "task/case-lifecycle-persistence/relational-case-store-for-lifecycle.md",
      "title": "Relational store adapter for the case-version lifecycle",
      "summary": "ICaseStore's relational adapter rewritten to assemble a whole case version from the manifest and its adopted revisions, and to persist each lifecycle mutation as one storage primitive the operations layer calls into.",
      "epic": "case-lifecycle-persistence"
    },
    {
      "id": "task/diagnosis-release-gate/diagnosis-refuses-a-draft-pin",
      "kind": "task",
      "file": "task/diagnosis-release-gate/diagnosis-refuses-a-draft-pin.md",
      "title": "Diagnosis refuses to pin a draft case version",
      "summary": "Before any evidence collection or judgment runs, the version named by a diagnose request must be released; a draft is refused with its own typed error.",
      "epic": "diagnosis-release-gate"
    }
  ],
