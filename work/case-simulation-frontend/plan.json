{
  "contract_version": "siegard-plan/3",
  "nodes": [
    {
      "id": "epic/simulation-cockpit",
      "kind": "epic",
      "file": "epic/simulation-cockpit.md",
      "title": "Simulation cockpit",
      "summary": "The route, the entry points into it, the mutation hooks, and the four screen regions that let a curator run and inspect a full-case or single-hypothesis simulation."
    },
    {
      "id": "epic/subject-derivation",
      "kind": "epic",
      "file": "epic/subject-derivation.md",
      "title": "Subject derivation",
      "summary": "The subject a simulation runs against, derived in the frontend from the version's own collection plan through the capability and connector-configuration registries, and rendered for the curator to complete."
    },
    {
      "id": "inventory/case-simulation-frontend-area",
      "kind": "inventory",
      "file": "inventory/case-simulation-frontend-area.md",
      "title": "Case simulation screen area",
      "summary": "The screen/ready-view/hooks triad, the route tree and app-shell label table, the mutation-hook precedent, the shared/TUI components, and the error-mapping table the new simulate route must extend."
    },
    {
      "id": "task/simulation-cockpit/case-result-panel",
      "kind": "task",
      "file": "task/simulation-cockpit/case-result-panel.md",
      "title": "Case result panel",
      "summary": "Renders the outcome/referral/text of the last full-case run, the in-memory run history, and the compare and stale-marking behavior.",
      "epic": "simulation-cockpit"
    },
    {
      "id": "task/simulation-cockpit/case-simulation-route",
      "kind": "task",
      "file": "task/simulation-cockpit/case-simulation-route.md",
      "title": "Simulation route and header",
      "summary": "Registers the new route and renders the header identifying the version, its state, and its links.",
      "epic": "simulation-cockpit"
    },
    {
      "id": "task/simulation-cockpit/detail-panel",
      "kind": "task",
      "file": "task/simulation-cockpit/detail-panel.md",
      "title": "Detail panel",
      "summary": "Renders the selected hypothesis's verdict, criterion, evidence and judgment metadata across three tabs.",
      "epic": "simulation-cockpit"
    },
    {
      "id": "task/simulation-cockpit/hypotheses-table",
      "kind": "task",
      "file": "task/simulation-cockpit/hypotheses-table.md",
      "title": "Hypotheses table",
      "summary": "Renders the precedence-ordered StatusTable of every manifested hypothesis, its actions, and the last-run summary line and timing bar.",
      "epic": "simulation-cockpit"
    },
    {
      "id": "task/simulation-cockpit/screen-assembly",
      "kind": "task",
      "file": "task/simulation-cockpit/screen-assembly.md",
      "title": "Screen assembly",
      "summary": "Composes the header, subject, hypotheses, detail and case-result regions into one working cockpit with cross-region gating and stale-marking.",
      "epic": "simulation-cockpit"
    },
    {
      "id": "task/simulation-cockpit/simulate-entry-links",
      "kind": "task",
      "file": "task/simulation-cockpit/simulate-entry-links.md",
      "title": "Simulate entry links",
      "summary": "Adds the \"Simulate\" entry control to the version screen and to the Versions tab of the case screen.",
      "epic": "simulation-cockpit"
    },
    {
      "id": "task/simulation-cockpit/use-simulate-case",
      "kind": "task",
      "file": "task/simulation-cockpit/use-simulate-case.md",
      "title": "use-simulate-case hook",
      "summary": "Dispatches the simulate-case operation and exposes its full response, following the apiFetch/useMutation convention.",
      "epic": "simulation-cockpit"
    },
    {
      "id": "task/simulation-cockpit/use-simulate-hypothesis",
      "kind": "task",
      "file": "task/simulation-cockpit/use-simulate-hypothesis.md",
      "title": "use-simulate-hypothesis hook",
      "summary": "Dispatches the simulate-hypothesis operation and exposes exactly one evaluation, resolving no outcome.",
      "epic": "simulation-cockpit"
    },
    {
      "id": "task/subject-derivation/subject-panel",
      "kind": "task",
      "file": "task/subject-derivation/subject-panel.md",
      "title": "Subject region",
      "summary": "Renders the subject-type selector, the requester field, the derived required fields, the free-attribute control, and the raw-subject-JSON link.",
      "epic": "subject-derivation"
    },
    {
      "id": "task/subject-derivation/use-simulation-subject-hook",
      "kind": "task",
      "file": "task/subject-derivation/use-simulation-subject-hook.md",
      "title": "use-simulation-subject hook",
      "summary": "Derives the subject's required fields from a case version's collection plan through the capability and connector-configuration registries.",
      "epic": "subject-derivation"
    }
  ],
