{
  "contract_version": "siegard-delivery/2",
  "nodes": [
    {
      "id": "implementation/capability-schema-draft-generation/colliding-names-favor-declared-order",
      "kind": "implementation",
      "file": "implementation/capability-schema-draft-generation/colliding-names-favor-declared-order.md",
      "title": "Capability schema draft input_schema collision resolution by declared order",
      "summary": "Extends draftedInputSchema to resolve a parameter or request-body-field name two or more parts of the chosen operation claim by declared order (path, query, header, cookie, then request body), giving the properties/required entry to the first claimant and disclosing every other one in the draft's unresolved list.",
      "task": "task/capability-schema-draft-generation/colliding-names-favor-declared-order"
    },
    {
      "id": "implementation/capability-schema-draft-generation/input-schema-from-parameters-and-request-body-fields",
      "kind": "implementation",
      "file": "implementation/capability-schema-draft-generation/input-schema-from-parameters-and-request-body-fields.md",
      "title": "Capability schema draft input_schema derivation",
      "summary": "Derives a capability schema draft's input_schema and its schema-not-reducible-to-a-type unresolved items from an OpenAPI operation's parameters and request-body fields, by extending the existing openapi-operation-reader.ts reader with type-reduction rather than duplicating its parameter, $ref or request-body reading.",
      "task": "task/capability-schema-draft-generation/input-schema-from-parameters-and-request-body-fields"
    },
    {
      "id": "implementation/capability-schema-draft-generation/output-schema-from-success-responses",
      "kind": "implementation",
      "file": "implementation/capability-schema-draft-generation/output-schema-from-success-responses.md",
      "title": "Output schema drafted from an operation's success responses",
      "summary": "Adds draftedOutputSchema, deriving a capability schema draft's output_schema and its unresolved items from the chosen operation's success-response fields, and extends the shared OpenAPI reader with the same type-reduction reading the input-schema draft already uses.",
      "task": "task/capability-schema-draft-generation/output-schema-from-success-responses"
    },
    {
      "id": "implementation/capability-schema-draft-operation/draft-capability-schema-from-openapi-endpoint",
      "kind": "implementation",
      "file": "implementation/capability-schema-draft-operation/draft-capability-schema-from-openapi-endpoint.md",
      "title": "HTTP surface for draft-capability-schema-from-openapi",
      "summary": "Registers POST /v1/draft-capability-schema-from-openapi, its zod DTO, its thin controller, and its generation module composing the existing fetcher/reader with the sibling epic's draftedInputSchema/draftedOutputSchema, answering a generated CapabilitySchemaDraft under HTTP 200 and a malformed request under HTTP 400 VALIDATION_ERROR.",
      "task": "task/capability-schema-draft-operation/draft-capability-schema-from-openapi-endpoint"
    },
    {
      "id": "proof/capability-schema-draft-generation/colliding-names-favor-declared-order",
      "kind": "proof",
      "file": "proof/capability-schema-draft-generation/colliding-names-favor-declared-order.md",
      "title": "Collision resolution by declared order — input_schema property-name precedence",
      "summary": "Proves that draftedInputSchema resolves a name two or more parts of the chosen operation claim by the fixed order path, query, header, cookie, request-body field (tie-broken by array position), disclosing every displaced claimant and handling an unreducible winner without promoting a later claimant.",
      "task": "task/capability-schema-draft-generation/colliding-names-favor-declared-order"
    },
    {
      "id": "proof/capability-schema-draft-generation/input-schema-from-parameters-and-request-body-fields",
      "kind": "proof",
      "file": "proof/capability-schema-draft-generation/input-schema-from-parameters-and-request-body-fields.md",
      "title": "Capability schema draft input_schema derivation",
      "summary": "Holds the fixed spec suite, with the collision-asserting test removed, up against this task's own seventeen behavioral criteria and the three nodes it can decide finitely, over the tree as the sibling collision task now leaves it.",
      "task": "task/capability-schema-draft-generation/input-schema-from-parameters-and-request-body-fields"
    },
    {
      "id": "proof/capability-schema-draft-generation/output-schema-from-success-responses",
      "kind": "proof",
      "file": "proof/capability-schema-draft-generation/output-schema-from-success-responses.md",
      "title": "Capability schema draft output_schema derivation from success responses",
      "summary": "Verifies that draftedOutputSchema builds output_schema's properties and required array from an operation's application/json success-response fields by the lowest declaring status, keys an enveloped field by its own name, excludes and discloses fields that do not reduce to one type, and drafts a present-but-empty properties object when no field is read.",
      "task": "task/capability-schema-draft-generation/output-schema-from-success-responses"
    },
    {
      "id": "proof/capability-schema-draft-operation/draft-capability-schema-from-openapi-endpoint",
      "kind": "proof",
      "file": "proof/capability-schema-draft-operation/draft-capability-schema-from-openapi-endpoint.md",
      "title": "Proof for the draft-capability-schema-from-openapi HTTP surface",
      "summary": "Route-level tests for draft-capability-schema-from-openapi's registration, fetch/derive/answer wiring, validation refusal and no-registration guarantee, plus a source-level check that the fetch/read/lookup reuse the existing machinery.",
      "task": "task/capability-schema-draft-operation/draft-capability-schema-from-openapi-endpoint"
    }
  ],
