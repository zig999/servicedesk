{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@tui/ui/*": ["../tui/frontend/src/shared/components/ui/*"],
      "@tui/lib/*": ["../tui/frontend/src/shared/lib/*"],
      "@/shared/lib/cn": ["../tui/frontend/src/shared/lib/cn"]
    }
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts"]
}
